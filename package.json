{
  "name": "cold-mailing",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "audit": "pnpm -C api audit --audit-level=high || pnpm -C app audit --audit-level=high || exit 0",
    "docker:dev": "docker compose -f docker-compose.dev.yml up -d --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:prod": "docker compose -f docker-compose.prod.yml up -d --build",
    "docker:prod:down": "docker compose -f docker-compose.prod.yml down",
    "docker:prod:delete": "docker compose -f docker-compose.prod.yml down -v"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "lint-staged": {
    "api/**/*.{js,ts,tsx,json}": "pnpm -C api exec biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "app/**/*.{js,jsx,ts,tsx}": "pnpm -C app exec eslint --fix"
  }
}