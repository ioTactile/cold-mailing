# Copier en .env à la racine : cp .env.example .env
# Obligatoire en production : COOKIE_SECRET, JWT_SECRET (générer des valeurs fortes)

# --- Base de données (réseau interne Docker) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=postgres

DATABASE_URL=postgresql://admin:admin@localhost:5432/postgres

# --- API (CORS et URL publiques : telles que vues par le navigateur) ---
# En local : http://localhost:3000 et http://localhost:3001
# Avec ton domaine (ex. jouer en ligne sur cold-mailing.iotactile.com) : utiliser https et le même domaine
# BASE_URL_API=https://api.cold-mailing.iotactile.com
# BASE_URL_APP=https://cold-mailing.iotactile.com
# NEXT_PUBLIC_API_URL=https://api.cold-mailing.iotactile.com
BASE_URL_API=http://localhost:3000
BASE_URL_APP=http://localhost:3001

# --- Secrets ---
COOKIE_SECRET=admin
JWT_SECRET=admin
COOKIE_MAX_AGE=604800
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# --- Cache / Redis ---
# URL de connexion Redis
REDIS_URL=redis://redis:6379

# --- Envoi d'emails (Resend) ---
RESEND_API_KEY=re_xxxx
FROM_EMAIL=onboarding@resend.dev

# --- Google Maps API Key ---
GOOGLE_MAPS_API_KEY=your-api-key

